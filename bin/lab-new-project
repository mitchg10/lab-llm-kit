#!/usr/bin/env bash
# lab-new-project — start (or adopt) a research project as its own git repo + uv environment.
# Projects live in $LAB_PROJECTS/<netid>/<project>, OUTSIDE the lab-llm tree.
#
#   lab new <name>                      new project, local git repo
#   lab new <name> --github             …and create a private repo in the lab's GitHub org + push
#   lab new <name> --remote <git-url>   …and push to an existing empty remote repo
#   lab init [--github|--remote URL]    turn the CURRENT folder into a lab project (keeps its files)
#   add --notebook to either: starter Jupyter notebook + model dropdown (then: lab notebook)
#   add --team <slug> to name the Cornell team whose key this project uses (see config/teams.txt);
#   without it you'll be asked to pick one. It's saved in .lab-project, and `lab-key` reads it.
set -euo pipefail

usage() { sed -n '2,12p' "$0"; exit "${1:-0}"; }
here=0; remote=""; github=0; notebook=0; name=""; team=""
while [ $# -gt 0 ]; do
  case "$1" in
    --here) here=1; shift ;;
    --github) github=1; shift ;;
    --notebook) notebook=1; shift ;;
    --remote) remote="${2:?--remote needs a URL}"; shift 2 ;;
    --team) team="${2:?--team needs a team slug}"; shift 2 ;;
    -h|--help) usage ;;
    -*) echo "unknown option $1"; usage 1 ;;
    *) name="$1"; shift ;;
  esac
done

KIT="${LAB_KIT:?open a new terminal so lab.env is loaded}"
bindir="$(cd "$(dirname "$0")" && pwd)"
say()  { printf '  \033[32m✓\033[0m %s\n' "$*"; }
note() { printf '  \033[33m!\033[0m %s\n' "$*"; }

# ---- who is this? (git needs a real person on a shared account) -------------
if [ -z "${GIT_AUTHOR_NAME:-}" ] || [ -z "${GIT_AUTHOR_EMAIL:-}" ]; then
  note "You're not logged in (lab-login), so git doesn't know who you are."
  read -r -p "  Your full name: " gname
  read -r -p "  Your email [${LAB_USER:-netid}@cornell.edu]: " gmail
  gmail="${gmail:-${LAB_USER:-netid}@cornell.edu}"
  export GIT_AUTHOR_NAME="$gname" GIT_COMMITTER_NAME="$gname" GIT_AUTHOR_EMAIL="$gmail" GIT_COMMITTER_EMAIL="$gmail"
fi
who="${LAB_USER:-${GIT_AUTHOR_EMAIL%@*}}"

# ---- where ------------------------------------------------------------------
if [ "$here" = 1 ]; then
  dir="$PWD"; name="${name:-$(basename "$dir")}"
  case "$dir" in "$LAB_ROOT"*) echo "Projects don't belong inside $LAB_ROOT — move it under $LAB_PROJECTS first."; exit 1;; esac
else
  [ -n "$name" ] || usage 1
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "Use letters, digits, - _ . in project names"; exit 1; }
  dir="$LAB_PROJECTS/$who/$name"
  [ -e "$dir" ] && { echo "$dir already exists (use: cd there && lab init)"; exit 1; }
fi
mkdir -p "$dir"/{data,prompts,outputs,notebooks}
cd "$dir"

# ---- which Cornell team pays for this project? (.lab-project; no secrets in it) ----
teams_file="$KIT/config/teams.txt"
known_teams=$(sed -e 's/#.*//' "$teams_file" 2>/dev/null | awk 'NF{print $1}')
if [ -z "$team" ] && [ -f .lab-project ]; then team=$(head -n 1 .lab-project | tr -d '[:space:]'); fi
if [ -z "$team" ] && [ -n "$known_teams" ] && [ -t 0 ]; then
  echo "  Which Cornell team is this project billed to?"
  i=1; while IFS= read -r t; do printf '    %d) %s\n' "$i" "$t"; i=$((i+1)); done <<< "$known_teams"
  read -r -p "  Number (Return to decide later): " pick
  [[ "$pick" =~ ^[0-9]+$ ]] && team=$(printf '%s\n' "$known_teams" | sed -n "${pick}p")
fi
if [ -n "$team" ]; then
  [[ "$team" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || { echo "Team names are lowercase letters, digits, - _ . (got '$team')"; exit 1; }
  if [ -n "$known_teams" ] && ! printf '%s\n' "$known_teams" | grep -qx -- "$team"; then
    echo "Team '$team' isn't in config/teams.txt — ask the PI which team to use."; exit 1
  fi
  [ -e .lab-project ] || printf '%s\n' "$team" > .lab-project
fi
pkg="$(echo "$name" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '-')"

# ---- Python environment (uv) --------------------------------------------------
if [ ! -f pyproject.toml ]; then uv init --bare --name "$pkg" --python 3.12 >/dev/null; fi
if ! uv add "${LABLLM_SOURCE:-$KIT/labllm}" >/dev/null 2>&1; then
  note "Couldn't add labllm from '$LABLLM_SOURCE'; using the copy on this Mac"
  uv add -q "$KIT/labllm"
fi
uv add -q pandas jupyterlab
uv add --dev nbstripout >/dev/null 2>&1 || true
say "uv environment (labllm, pandas, jupyterlab) — add more with: uv add <package>"
[ "$notebook" = 1 ] && "$bindir/lab-notebook" --setup && say "starter notebook: notebooks/quickstart.ipynb (model dropdown, autosave)"

# ---- starter files (never overwrite existing ones) --------------------------------
cpnew() { [ -e "$2" ] || cp "$1" "$2"; }
cpnew "$KIT/examples/quickstart.py" quickstart.py
cpnew "$KIT/examples/prompts/system_coding.md" prompts/system_coding.md
cpnew "$KIT/examples/prompts/code_excerpt.md" prompts/code_excerpt.md
cpnew "$KIT/examples/prompts/schema.json" prompts/schema.json
cpnew "$KIT/examples/data/synthetic_excerpts.csv" data/synthetic_excerpts.csv
cpnew "$KIT/config/project-template/gitignore" .gitignore
cpnew "$KIT/config/project-template/AGENTS.md" AGENTS.md
[ -e CLAUDE.md ] || printf '@AGENTS.md\n' > CLAUDE.md
if [ ! -e .labscan-allow ]; then
  { printf '# Terms the identifier scan should accept in this repo (pseudonyms, course codes, the\n'
    printf "# researchers' own NetIDs…), one per line. Never list real participant identifiers here.\n"
    printf '%s\n' "$who"; } > .labscan-allow
fi
if [ ! -e README.md ]; then
  sed -e "s#__NAME__#$name#g" -e "s#__OWNER__#${GIT_AUTHOR_NAME} (${who})#g" -e "s#__DATE__#$(date +%Y-%m)#g" \
      "$KIT/config/project-template/README.md" > README.md
fi

# ---- git ---------------------------------------------------------------------------
[ -d .git ] || git init -q -b main
mkdir -p .githooks
cp "$KIT/config/git-hooks/pre-commit" .githooks/pre-commit && chmod +x .githooks/pre-commit
git config core.hooksPath .githooks
# strip notebook outputs on commit (outputs often contain data)
uv run nbstripout --install --attributes .gitattributes >/dev/null 2>&1 || note "nbstripout not set up; clear notebook outputs before committing"
git add -A
if git diff --cached --quiet; then :; else
  if git commit -q -m "Start project $name (lab new)"; then say "git repo with first commit ($(git rev-parse --short HEAD))"
  else note "First commit was blocked by the safety hook (see above). Fix those files, then: git add -A && git commit -m 'Start project'"; fi
fi

if [ "$github" = 1 ]; then
  org="${LAB_GIT_REMOTE_BASE##*/}"
  if [[ "$org" == *"["* ]]; then note "LAB_GIT_REMOTE_BASE isn't set in lab.env — skipping GitHub";
  elif [ -z "${GH_TOKEN:-}" ]; then note "No GitHub token in this window (lab-login) — skipping. Later: lab new --here --github";
  else gh repo create "$org/$name" --private --source . --remote origin --push >/dev/null && say "pushed to private repo $org/$name"; fi
elif [ -n "$remote" ]; then
  git remote add origin "$remote" 2>/dev/null || git remote set-url origin "$remote"
  git push -u origin main && say "pushed to $remote"
fi

echo
say "Project ready: $dir"
if [ -n "$team" ]; then say "Cornell team: $team (in .lab-project) — load your key with: lab-key"
else note "No Cornell team set. Add one later: echo <team> > .lab-project   (teams: $teams_file)"; fi
notebook_hint=""
[ "$notebook" = 1 ] && notebook_hint='    lab notebook                # open the starter notebook in your browser
'
cat <<EOF
    cd "$dir"
    uv run quickstart.py        # check the models answer
${notebook_hint}    uv run jupyter lab          # notebooks
    git add -A && git commit -m "…"   # save a version (data/ and outputs/ are never committed)
  Version control help: $KIT/docs/VERSION_CONTROL.md
EOF
