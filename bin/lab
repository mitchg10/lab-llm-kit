#!/usr/bin/env bash
# lab — front door for the lab's LLM tools. Type `lab` for the menu.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"

menu() {
cat <<EOF

  Lab LLM tools  (lab constitution: $LAB_CONSTITUTION)

  START HERE
    lab-login              who you are (logs + git) and GitHub token — this window only
    lab-key                load your Cornell key for this project's team — this window only
    lab ui                 the same thing with buttons — no commands to remember
    lab new <project>      new project: its own git repo + Python (uv), outside the lab tools
                           (add --notebook for a starter Jupyter notebook)
    lab notebook           open this project's notebooks in your browser
    lab init               make the current folder a lab project (git + uv + safety hook)
    lab scan <file>        check a file for identifiers BEFORE giving it to any model

  USE MODELS
    labllm chat            chat with a local model in the terminal (labllm --help for more)
    opencode               coding/analysis agent — pick local or Cornell models inside
    claude-local           Claude Code running on a local model
    claude-cornell         Claude Code via the Cornell AI Gateway (needs lab-key)
    codex                  Codex on a local model  (codex --profile cornell for the gateway)
    open -a "LM Studio"    chat app (the PI's favourite)

  MODELS
    lab models             list installed models (lab models help for more)
    lab models pull ollama <name>      download a model once, shared by all tools

  MAINTENANCE
    lab status             is everything running?
    lab sync               push constitution/skills/configs to every agent
    lab update             update the kit, tools and agents

  Docs: $LAB_KIT/docs/STUDENT_QUICKSTART.md   ·   git help: $LAB_KIT/docs/VERSION_CONTROL.md
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) menu ;;
  login)   echo "Type:  lab-login   (it has to run in your current window, so it's a separate command)";;
  new)     exec "$here/lab-new-project" "$@" ;;
  init)    exec "$here/lab-new-project" --here "$@" ;;
  ui)      exec "$here/lab-ui" "$@" ;;
  notebook) exec "$here/lab-notebook" "$@" ;;
  scan)    exec "$here/lab-scan" "$@" ;;
  models)  exec "$here/lab-models" "$@" ;;
  status)  exec "$here/lab-status" "$@" ;;
  sync)    exec "$here/lab-sync" "$@" ;;
  update)  exec "$here/lab-update" "$@" ;;
  *) echo "Unknown: lab $cmd"; menu; exit 1 ;;
esac
