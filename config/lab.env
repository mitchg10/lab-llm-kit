# =============================================================================
# lab.env — shared environment for the lab's local-LLM Mac Studio
#
# Sourced by ~/.zshrc (installed by setup/03-configure.sh). Put site values in
# lab.local.env (see below), then open a new terminal (or run `source ~/.zshrc`). Keep secrets OUT of this
# file: Cornell API keys are loaded per-window with `lab-key` (see docs).
# =============================================================================

# Site values (lab name, PI, gateway URL, GitHub org) go in config/lab.local.env, which is
# gitignored, so this tracked file stays a clean template. It is read first, and every
# `${VAR:-default}` below yields to it.
_lab_local="${LAB_ROOT:-/Users/Shared/lab-llm}/kit/config/lab.local.env"
[ -f "$_lab_local" ] && . "$_lab_local"
unset _lab_local

# ---- Lab identity (set these in lab.local.env) -----------------------------
export LAB_NAME="${LAB_NAME:-[LAB NAME]}"
export LAB_PI="${LAB_PI:-[PI NAME]}"
export LAB_ADMIN_CONTACT="${LAB_ADMIN_CONTACT:-[admin name / email]}"
export LAB_IRB_CONTACT="${LAB_IRB_CONTACT:-Cornell IRB / ORIA — [email or URL]}"

# ---- Where everything lives -------------------------------------------------
# /Users/Shared survives a later move to per-person macOS accounts.
export LAB_ROOT="${LAB_ROOT:-/Users/Shared/lab-llm}"
export LAB_KIT="$LAB_ROOT/kit"                      # this repository
export LAB_MODELS="$LAB_ROOT/models"                # every model store lives under here
export LAB_LOGS="$LAB_ROOT/logs"                    # run logs (metadata only, no content)
export LAB_CONSTITUTION="$LAB_KIT/constitution/LAB_CONSTITUTION.md"
# Default system prompt for CHAT use only (LM Studio preset, `lab-*` Ollama models,
# `labllm ask`). API calls through labllm never add it unless you ask for it.
export LAB_DEFAULT_CHAT_PROMPT="$LAB_KIT/constitution/DEFAULT_CHAT_PROMPT.md"

# ---- Research projects (deliberately OUTSIDE the lab-llm tree) ---------------
# Each project is its own git repository with its own uv environment, so the
# lab tooling never grows with student work and projects can live on GitHub.
export LAB_PROJECTS="${LAB_PROJECTS:-/Users/Shared/research}"   # <netid>/<project>/
# Where project repos get pushed (private repos in the lab's org). Leave the
# placeholder until the lab has an org; projects still work locally with git.
export LAB_GIT_REMOTE_BASE="${LAB_GIT_REMOTE_BASE:-https://github.com/[LAB-ORG]}"
# How projects depend on labllm. A git URL pinned to a tag makes projects
# reproducible and portable off this Mac; the local path is the fallback.
#   e.g. "labllm @ git+https://github.com/[LAB-ORG]/lab-llm-kit@labllm-v0.2.0#subdirectory=labllm"
export LABLLM_SOURCE="${LABLLM_SOURCE:-$LAB_KIT/labllm}"

# ---- Model stores (shared) --------------------------------------------------
export OLLAMA_MODELS="$LAB_MODELS/ollama"
export HF_HOME="$LAB_MODELS/huggingface"
export LMSTUDIO_MODELS="$LAB_MODELS/lmstudio"       # also set inside LM Studio > My Models
export HF_HUB_DISABLE_TELEMETRY=1
export HF_HUB_ENABLE_HF_TRANSFER=0

# ---- Local endpoints (bound to this machine only) ---------------------------
export OLLAMA_HOST="127.0.0.1:11434"
export OLLAMA_BASE_URL="http://127.0.0.1:11434"
export LMSTUDIO_BASE_URL="http://127.0.0.1:1234"

# ---- Cornell AI Gateway (LiteLLM, OpenAI-compatible) ------------------------
# Get the exact base URL from the gateway's management UI when you create a key.
export CORNELL_AI_BASE_URL="${CORNELL_AI_BASE_URL:-https://[CORNELL-GATEWAY-HOST]/v1}"
# CORNELL_AI_API_KEY is deliberately NOT set here. The PI issues each student one key per
# Cornell team; run `lab-key` inside a project and it loads the key for that project's team
# (named in the project's .lab-project file; the valid teams are listed in config/teams.txt).
# Where the key comes from: prompt (type/paste it each window) or age (kept encrypted with
# your own passphrase). See docs/KEY_MANAGEMENT.md.
export LAB_KEY_BACKEND="${LAB_KEY_BACKEND:-prompt}"

# ---- Default models (change freely; `lab-models recommend` lists options) ---
export LAB_DEFAULT_MODEL="${LAB_DEFAULT_MODEL:-qwen3:30b}"       # API default (plain model: your prompts only)
export LAB_CHAT_MODEL="${LAB_CHAT_MODEL:-lab-qwen3:30b}"         # chat default (has the default chat prompt)
export LAB_AGENT_MODEL="${LAB_AGENT_MODEL:-qwen3-coder:30b}"     # coding agents
export LAB_EMBED_MODEL="${LAB_EMBED_MODEL:-nomic-embed-text}"    # embeddings

# ---- Toolchain managers -----------------------------------------------------
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
export UV_PYTHON_PREFERENCE=only-managed            # uv owns Python; never touch system Python
export PATH="$HOME/.local/bin:$LAB_KIT/bin:$PATH"   # uv tools + lab helpers

alias lab-login='source "$LAB_KIT/bin/lab-login"'   # must be sourced (sets vars in this window)
alias lab-key='source "$LAB_KIT/bin/lab-key"'       # likewise: loads this project's Cornell key
# On `cd` into a project whose Cornell team differs from the key in this window, print a hint.
if [ -n "${ZSH_VERSION:-}" ]; then
  _lab_key_chpwd() { source "$LAB_KIT/bin/lab-key" --auto; }
  autoload -Uz add-zsh-hook 2>/dev/null && add-zsh-hook chpwd _lab_key_chpwd
fi

# ---- Agent behaviour --------------------------------------------------------
# OpenCode also reads ~/.claude/skills; we already give it ~/.agents/skills,
# so turn off the duplicate scan.
export OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1
export OPENCODE_DISABLE_CLAUDE_CODE_PROMPT=1        # it gets the constitution via its own config
# Give coding agents the lab constitution as background instructions (on/off).
# This is agent context (how to handle files and data), not a system prompt on
# your analysis calls. Change it, then run `lab sync`.
export LAB_AGENT_CONSTITUTION="${LAB_AGENT_CONSTITUTION:-on}"
